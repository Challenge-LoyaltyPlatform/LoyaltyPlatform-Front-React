# URL base da API Java, sem barra no final.
# Local: copie este arquivo para .env.local (o .gitignore já ignora *.local).
# Vercel: cadastre VITE_API_URL em Settings > Environment Variables com a URL HTTPS
# da API publicada. Página HTTPS não consegue chamar API HTTP (o navegador bloqueia).
VITE_API_URL=http://localhost:8080

# true = usa a API simulada em memória (src/services/apiSimulada.ts) no lugar do back-end.
# Serve para desenvolver o front antes do Java ficar pronto. Nunca ligue na Vercel.
# Depois de mudar este valor, pare e rode o npm run dev de novo.
VITE_API_MOCK=false
